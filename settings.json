{
  "skillListingBudgetFraction": 0.03,
  "permissions": {
    "allow": [
      "Read(~/.claude/**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(uv *)",
      "Bash(Rscript *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(uv *)",
      "PowerShell(Rscript *)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(git rm *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Bash(git -c * push)",
      "Bash(git -c * push *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git rm *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git -C * push)",
      "PowerShell(git -C * push *)",
      "PowerShell(git -c * push)",
      "PowerShell(git -c * push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/1_raw_data/**)",
      "Bash(git * --force)",
      "Bash(git * --force *)",
      "Bash(git * --force-with-lease*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git -C * push -f)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -c * push -f)",
      "Bash(git -c * push -f *)",
      "Bash(git -c * push * -f)",
      "Bash(git -c * push * -f *)",
      "Bash(git * --hard)",
      "Bash(git * --hard *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git -C * clean)",
      "Bash(git -C * clean *)",
      "Bash(git -c * clean)",
      "Bash(git -c * clean *)",
      "PowerShell(git * --force)",
      "PowerShell(git * --force *)",
      "PowerShell(git * --force-with-lease*)",
      "PowerShell(git push -f)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git -C * push -f)",
      "PowerShell(git -C * push -f *)",
      "PowerShell(git -C * push * -f)",
      "PowerShell(git -C * push * -f *)",
      "PowerShell(git -c * push -f)",
      "PowerShell(git -c * push -f *)",
      "PowerShell(git -c * push * -f)",
      "PowerShell(git -c * push * -f *)",
      "PowerShell(git * --hard)",
      "PowerShell(git * --hard *)",
      "PowerShell(git clean)",
      "PowerShell(git clean *)",
      "PowerShell(git -C * clean)",
      "PowerShell(git -C * clean *)",
      "PowerShell(git -c * clean)",
      "PowerShell(git -c * clean *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/scripts/session-start.ps1\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/scripts/context-in-prompt.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/scripts/statusline.ps1\""
  }
}
